{
  // Terminal > Run Task... > "Set up (first time)"
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up (first time)",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt -r requirements-dev.txt",
      "windows": {
        "command": "py -m venv .venv; .venv\\Scripts\\pip install -r requirements.txt -r requirements-dev.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Task Runner",
      "type": "shell",
      "command": ".venv/bin/python -m taskrunner.cli serve",
      "windows": { "command": ".venv\\Scripts\\python -m taskrunner.cli serve" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -v tests",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -v tests" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
