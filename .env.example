# Copy this file to ".env" and put your keys in it. Never share or commit .env.
# Used by start-windows.bat and by VS Code's Run and Debug panel.

# For the "Claude" tab - get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# For the "OpenAI" tab - get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: the OpenAI model used when the model box is left empty
# TASKRUNNER_OPENAI_MODEL=gpt-4o
